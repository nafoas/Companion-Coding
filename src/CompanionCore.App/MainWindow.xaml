<Window x:Class="CompanionCore.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Companion Core (dev skeleton)"
        Width="760" Height="900"
        WindowStartupLocation="CenterScreen">
    <!--
        Deliberately plain through Task 6: no final names, themed labels, character
        wording, decoration, or polished layout. The ellipse below is a neutral
        placeholder icon, not final artwork.
    -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Ellipse Grid.Row="0" Width="24" Height="24" Fill="Gray"
                  HorizontalAlignment="Left" Margin="0,0,0,8"
                  ToolTip="placeholder icon" />

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock x:Name="StatusText" Text="Status unavailable." />
            <!-- FIX-07: a live pulse, counts and state names only, so a silent pipeline is visible. -->
            <TextBlock x:Name="PulseText" Text="Pulse: waiting for the companion host."
                       TextWrapping="Wrap" FontFamily="Consolas" Margin="0,4,0,0" />
        </StackPanel>

        <TextBlock x:Name="TargetStatusText" Grid.Row="2" Text="No target is authorized."
                   TextWrapping="Wrap" Margin="0,0,0,4" />

        <TextBlock x:Name="SelectionStatusText" Grid.Row="3" Text="No target selected."
                   TextWrapping="Wrap" Margin="0,0,0,4" />

        <TextBlock x:Name="HotkeyStatusText" Grid.Row="4" Text="Privacy hotkey not initialized."
                   TextWrapping="Wrap" Margin="0,0,0,8" />

        <Grid Grid.Row="5" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="TargetCombo" Grid.Column="0"
                      DisplayMemberPath="NeutralDisplayLabel"
                      SelectionChanged="TargetCombo_SelectionChanged" />
            <Button x:Name="RefreshTargetsButton" Grid.Column="1" Content="Refresh targets"
                    Margin="8,0,0,0" Padding="10,4" Click="RefreshTargetsButton_Click" />
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Vertical" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Authorization:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="AuthorizationCategoryCombo" Width="160" />
                <CheckBox x:Name="TrustedGameCheckBox" Content="Trusted game content policy"
                          VerticalAlignment="Center" Margin="10,0,0,0" />
                <Button x:Name="ApplyPolicyButton" Content="Apply policy" Margin="10,0,0,0"
                        Padding="10,4" Click="ApplyPolicyButton_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AuthorizeButton" Content="Authorize selected target"
                        Padding="10,4" Margin="0,0,6,0" Click="AuthorizeButton_Click" />
                <Button x:Name="PrivacyStopButton" Content="Privacy stop"
                        Padding="10,4" Margin="0,0,6,0" Click="PrivacyStopButton_Click" />
                <Button x:Name="ResumeTargetButton" Content="Explicit resume"
                        Padding="10,4" Margin="0,0,6,0" Click="ResumeTargetButton_Click" />
                <Button x:Name="EndTargetButton" Content="End target"
                        Padding="10,4" Click="EndTargetButton_Click" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="7" Orientation="Vertical" Margin="0,0,0,8">
            <TextBlock x:Name="AttentionStatusText" Text="No attention sheet is available."
                       TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBlock x:Name="CompanionStatusText" Text="Companion core not started."
                       TextWrapping="Wrap" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Manual normalized region:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="ManualXBox" Width="44" Text="0.20" ToolTip="X" Margin="0,0,4,0" />
                <TextBox x:Name="ManualYBox" Width="44" Text="0.20" ToolTip="Y" Margin="0,0,4,0" />
                <TextBox x:Name="ManualWidthBox" Width="44" Text="0.40" ToolTip="Width" Margin="0,0,4,0" />
                <TextBox x:Name="ManualHeightBox" Width="44" Text="0.40" ToolTip="Height" Margin="0,0,6,0" />
                <Button Content="Apply region" Padding="8,3" Margin="0,0,4,0"
                        Click="ApplyManualRegionButton_Click" />
                <Button Content="Clear region" Padding="8,3"
                        Click="ClearManualRegionButton_Click" />
            </StackPanel>
        </StackPanel>

        <!--
            CORE-12 placeholder commands: plain buttons for every orchestrator command, so the
            Core Prince milestone can be walked by hand. Neutral wording only (no personality).
        -->
        <GroupBox x:Name="CompanionCommands" Grid.Row="8" Header="Companion commands (placeholder)"
                  IsEnabled="False" Margin="0,0,0,8">
            <StackPanel Orientation="Vertical" Margin="6">
                <TextBlock x:Name="BraincaseStatusText" Text="Braincase: not started." TextWrapping="Wrap" Margin="0,0,0,6" />
                <!-- FIX-10: each command's result stays here; notices never overwrite it. -->
                <TextBlock x:Name="CommandResultText" Text="Last command: none yet." TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Reply:" VerticalAlignment="Center" Width="96" />
                    <Button Content="Click" Padding="8,3" Margin="0,0,4,0" Tag="Click" Click="ReplyButton_Click" />
                    <Button Content="Yes / no" Padding="8,3" Margin="0,0,4,0" Tag="YesNo" Click="ReplyButton_Click" />
                    <Button Content="Acknowledge" Padding="8,3" Margin="0,0,4,0" Tag="Acknowledgement" Click="ReplyButton_Click" />
                    <Button Content="Substantive" Padding="8,3" Margin="0,0,4,0" Tag="Substantive" Click="ReplyButton_Click" />
                    <CheckBox x:Name="ConversationLockCheckBox" Content="Lock conversation" VerticalAlignment="Center"
                              Margin="8,0,0,0" Click="ConversationLockCheckBox_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Quiet check:" VerticalAlignment="Center" Width="96" />
                    <Button Content="Keep watching" Padding="8,3" Margin="0,0,4,0" Tag="KeepWatching" Click="QuietButton_Click" />
                    <Button Content="Naptime" Padding="8,3" Margin="0,0,4,0" Tag="Naptime" Click="QuietButton_Click" />
                    <Button Content="Back eventually" Padding="8,3" Margin="0,0,4,0" Tag="BackEventually" Click="QuietButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="After exit:" VerticalAlignment="Center" Width="96" />
                    <Button Content="Consolidate" Padding="8,3" Margin="0,0,4,0" Tag="Consolidate" Click="ExitButton_Click" />
                    <Button Content="Wait for relaunch" Padding="8,3" Margin="0,0,4,0" Tag="WaitForRelaunch" Click="ExitButton_Click" />
                    <Button Content="Preserve paused" Padding="8,3" Margin="0,0,4,0" Tag="PreservePaused" Click="ExitButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Watch task:" VerticalAlignment="Center" Width="96" />
                    <TextBox x:Name="WatchTaskKeyBox" Width="200" Text="synthetic.event" Margin="0,0,4,0" />
                    <Button Content="Add watch task" Padding="8,3" Margin="0,0,4,0" Click="AddWatchTaskButton_Click" />
                    <Button Content="Take photograph" Padding="8,3" Margin="12,0,4,0" Click="TakePhotographButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Vault:" VerticalAlignment="Center" Width="96" />
                    <Button Content="Export Vault..." Padding="8,3" Margin="0,0,4,0" Click="ExportVaultButton_Click" />
                    <Button Content="Repair Vault..." Padding="8,3" Margin="0,0,4,0" Click="RepairVaultButton_Click" />
                </StackPanel>
                <TextBlock Text="Recent notices (newest first):" Margin="0,0,0,2" />
                <ListBox x:Name="NoticeLog" Height="140" />
            </StackPanel>
        </GroupBox>

        <TextBox x:Name="InputBox" Grid.Row="9" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="10" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="NapButton" Content="Nap" Width="70" Margin="0,0,6,0" Click="NapButton_Click" />
            <Button x:Name="WakeButton" Content="Wake" Width="70" Margin="0,0,6,0" Click="WakeButton_Click" />
            <Button x:Name="StopButton" Content="Stop" Width="70" Click="StopButton_Click" />
        </StackPanel>
    </Grid>
</Window>
