<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CompanionCore.App</RootNamespace>
    <AssemblyName>CompanionCore.App</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CompanionCore.Runtime\CompanionCore.Runtime.csproj" />
    <ProjectReference Include="..\CompanionCore.Presentation\CompanionCore.Presentation.csproj" />
    <ProjectReference Include="..\CompanionCore.Capture.Contracts\CompanionCore.Capture.Contracts.csproj" />
    <ProjectReference Include="..\CompanionCore.Capture.Client\CompanionCore.Capture.Client.csproj" />
    <ProjectReference Include="..\CompanionCore.Capture.Worker\CompanionCore.Capture.Worker.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CompanionCore.Privacy\CompanionCore.Privacy.csproj" />
    <ProjectReference Include="..\CompanionCore.TargetAuth\CompanionCore.TargetAuth.csproj" />
    <ProjectReference Include="..\CompanionCore.TargetAuth.Windows\CompanionCore.TargetAuth.Windows.csproj" />
  </ItemGroup>

  <Target Name="CopyDedicatedCaptureWorker" AfterTargets="Build">
    <PropertyGroup>
      <CaptureWorkerOutputDirectory>$(MSBuildProjectDirectory)\..\CompanionCore.Capture.Worker\bin\$(Configuration)\net10.0-windows10.0.19041.0</CaptureWorkerOutputDirectory>
    </PropertyGroup>
    <ItemGroup>
      <CaptureWorkerOutput Include="$(CaptureWorkerOutputDirectory)\CompanionCore.Capture.Worker.exe" />
      <CaptureWorkerOutput Include="$(CaptureWorkerOutputDirectory)\CompanionCore.Capture.Worker"
                           Condition="Exists('$(CaptureWorkerOutputDirectory)\CompanionCore.Capture.Worker')" />
      <CaptureWorkerOutput Include="$(CaptureWorkerOutputDirectory)\CompanionCore.Capture.Worker.dll" />
      <CaptureWorkerOutput Include="$(CaptureWorkerOutputDirectory)\CompanionCore.Capture.Worker.deps.json" />
      <CaptureWorkerOutput Include="$(CaptureWorkerOutputDirectory)\CompanionCore.Capture.Worker.runtimeconfig.json" />
      <CaptureWorkerOutput Include="$(CaptureWorkerOutputDirectory)\Microsoft.Windows.SDK.NET.dll" />
      <CaptureWorkerOutput Include="$(CaptureWorkerOutputDirectory)\WinRT.Runtime.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(CaptureWorkerOutput)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(CaptureWorkerOutput.Identity)')" />
  </Target>

</Project>
