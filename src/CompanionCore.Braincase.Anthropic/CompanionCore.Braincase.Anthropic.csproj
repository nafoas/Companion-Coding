<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CompanionCore.Braincase</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    The only networking assembly in the Braincase path. The bridge (CompanionCore.Api)
    stays network-free; this adapter plugs into its ISemanticProvider seam.
  -->
  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.55.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CompanionCore.Api\CompanionCore.Api.csproj" />
  </ItemGroup>

</Project>
